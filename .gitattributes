# Same line endings on every machine (macOS, Linux, and Windows later).
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tif binary
*.tiff binary
*.glb binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.joblib binary
*.pkl binary
*.npz binary
